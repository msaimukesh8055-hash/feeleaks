# .env.example
# Copy to .env.local and fill in. Never commit real values.
# On Vercel: Project > Settings > Environment Variables.

# Signs the anonymous browser identity cookie. Any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IDENTITY_SECRET=

# Supabase (later) — from Supabase dashboard > Project Settings > API.
# Used from the server only; never prefix with NEXT_PUBLIC_.
# Until these are set, the site runs in demo mode (data kept in a local file).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Anthropic — server-side only, never prefix with NEXT_PUBLIC_.
# Without it, reporters fill in the fee breakdown by hand.
ANTHROPIC_API_KEY=

# Browser push notifications for "Follow" (free, no third-party service).
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact link for push services, e.g. https://feeleaks.vercel.app/about
VAPID_SUBJECT=

# Public site address, used in share links and emails. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://feeleaks.vercel.app

# Optional: where demo mode keeps its data file (default: .data/ locally, /tmp on Vercel)
FEELEAKS_DATA_DIR=
